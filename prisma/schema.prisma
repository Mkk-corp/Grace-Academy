generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id
  name        String   @unique
  description String   @default("")
  permissions String[]
  users       User[]
}

model User {
  id                 String    @id @default(cuid())
  name               String
  username           String    @default("")
  email              String    @unique
  phone              String    @default("")
  password           String?
  googleId                   String?   @unique
  avatar             String?
  roleId             String?
  role               Role?     @relation(fields: [roleId], references: [id])
  source             String    @default("website")
  forcePasswordReset Boolean   @default(false)
  passwordHistory    String[]  @default([])
  dob                String?
  gender             String?
  bio                String?
  country            String?
  city               String?
  nationalId         String?
  emergencyContact   String?
  educationLevel     String?
  coursesTaken       String?
  expectedLevel      String?
  isEmployed         Boolean?
  jobTitle           String?
  employer           String?
  faculty            String?
  university         String?
  teachingExperience Boolean?
  teachingWhere      String?
  englishLevel       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  bookingsAsStudent  Booking[] @relation("StudentBookings")
  bookingsAsAssessor Booking[] @relation("AssessorBookings")
}

model Booking {
  id            String   @id @default(cuid())
  studentId     String
  student       User     @relation("StudentBookings",  fields: [studentId],  references: [id])
  assessorId    String
  assessor      User     @relation("AssessorBookings", fields: [assessorId], references: [id])
  studentName   String
  studentEmail  String
  assessorName  String
  assessorEmail String
  date          String
  dayKey        String
  slotMin       Int
  meetLink      String?
  status        String   @default("confirmed")
  reminderSent       Boolean  @default(false)
  emailReminderSent  Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model OtpSession {
  id          String    @id @default(cuid())
  email       String    @unique
  otpHash     String
  expiresAt   DateTime
  resendCount Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
}

model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String   @default("")
  message     String
  read        Boolean  @default(false)
  submittedAt DateTime @default(now())
}
