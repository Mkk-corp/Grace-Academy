generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id
  name        String   @unique
  description String   @default("")
  permissions String[]
  users       User[]
}

model User {
  id                 String               @id @default(cuid())
  name               String
  username           String               @default("")
  email              String               @unique
  phone              String               @default("")
  password           String?
  googleId           String?              @unique
  avatar             String?
  roleId             String?
  role               Role?                @relation(fields: [roleId], references: [id])
  source             String               @default("website")
  forcePasswordReset Boolean              @default(false)
  passwordHistory    String[]             @default([])
  dob                String?
  gender             String?
  bio                String?
  country            String?
  city               String?
  nationalId         String?
  emergencyContact   String?
  educationLevel     String?
  coursesTaken       String?
  expectedLevel      String?
  isEmployed         Boolean?
  jobTitle           String?
  employer           String?
  faculty            String?
  university         String?
  teachingExperience Boolean?
  teachingWhere      String?
  englishLevel       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  bookingsAsStudent  Booking[]            @relation("StudentBookings")
  bookingsAsAssessor Booking[]            @relation("AssessorBookings")
  scheduleTemplate   ScheduleTemplate?
  slotRequests       SlotRequest[]        @relation("AssessorSlotRequests")
  notifications      Notification[]       @relation("UserNotifications")
  assessorPreference AssessorPreference?
}

model Booking {
  id                String             @id @default(cuid())
  studentId         String
  student           User               @relation("StudentBookings",  fields: [studentId],  references: [id], onDelete: Cascade)
  assessorId        String
  assessor          User               @relation("AssessorBookings", fields: [assessorId], references: [id], onDelete: Cascade)
  studentName       String
  studentEmail      String
  assessorName      String
  assessorEmail     String
  date              String
  dayKey            String
  slotMin           Int
  meetLink          String?
  recordingLink     String?
  status            String             @default("confirmed")
  reminderSent      Boolean            @default(false)
  emailReminderSent Boolean            @default(false)
  createdAt         DateTime           @default(now())
  report            AssessmentReport?
}

model AssessmentReport {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assessorId      String
  studentId       String
  studentName     String
  studentEmail    String
  assessorName    String
  date            String
  slotMin         Int
  feedback        String
  feedbackAr      String   @default("")
  englishLevel    String
  suggestedCourse String
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assessorId])
  @@index([studentId])
}

model ScheduleTemplate {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SlotRequest {
  id               String    @id @default(cuid())
  assessorId       String
  assessor         User      @relation("AssessorSlotRequests", fields: [assessorId], references: [id], onDelete: Cascade)
  currentSchedule  Json?
  proposedSchedule Json
  reason           String
  status           String    @default("pending")
  adminNote        String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedByName   String?
  createdAt        DateTime  @default(now())
}

model Notification {
  id            String   @id @default(cuid())
  recipientType String
  recipientId   String?
  recipient     User?    @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type          String
  title         String
  body          String
  meta          Json
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model AssessorPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accent    String   @default("american")
  topics    String[] @default([])
  updatedAt DateTime @updatedAt
}

model ScheduleConfig {
  id       String @id
  minDays  Int    @default(2)
  maxDays  Int    @default(5)
  minSlots Int    @default(4)
  maxSlots Int    @default(32)
}

model OtpSession {
  id          String    @id @default(cuid())
  email       String    @unique
  otpHash     String
  expiresAt   DateTime
  resendCount Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
}

model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String   @default("")
  message     String
  read        Boolean  @default(false)
  submittedAt DateTime @default(now())
}

model PayrollTransfer {
  id                String   @id @default(cuid())
  assessorId        String
  assessorName      String
  assessorEmail     String
  month             String
  placementCount    Int      @default(0)
  speakingCount     Int      @default(0)
  placementRate     Float    @default(0)
  speakingRate      Float    @default(0)
  totalAmount       Float    @default(0)
  currency          String   @default("USD")
  paymentMethod     String
  evidenceData      String?
  evidenceName      String?
  transferredById   String
  transferredByName String
  transferredAt     DateTime @default(now())

  @@index([assessorId])
  @@index([month])
}

model Category {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String   @default("")
  createdAt DateTime @default(now())
  courses   Course[]
}

model Course {
  id               String    @id @default(cuid())
  nameEn           String
  nameAr           String    @default("")
  descEn           String
  descAr           String    @default("")
  marketingEn      String
  marketingAr      String    @default("")
  durationMonths   Int?
  durationSessions Int
  teacherCount     Int       @default(0)
  studentCount     Int       @default(0)
  needsSpeaking    Boolean   @default(false)
  speakingSessions Int?
  needsLibrary     Boolean   @default(false)
  libraryTypes     String[]  @default([])
  level            String    @default("")
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([categoryId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  actorRole String?
  action    String
  entity    String?
  entityId  String?
  meta      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorRole])
  @@index([action])
}
